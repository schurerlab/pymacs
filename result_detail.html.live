{% extends "base.html" %}
{% block title %}{{ system.system }} · Results · PyMACS Lab Jobs{% endblock %}
{% block head %}
<script src="{{ url_for('static', filename='3Dmol-min.js') }}"></script>
<style>
  :root{--bg:#05060a;--panel:#0b1020;--text:#d5edff;--muted:#83a9cf;--cyan:#35d0ff;--green:#18ff8b;--pink:#ff2bd6;--line:#23375d}body{background:radial-gradient(circle at 90% 0,rgba(53,208,255,.17),transparent 29%),radial-gradient(circle at 5% 25%,rgba(255,43,214,.1),transparent 25%),var(--bg);color:var(--text)}.site-header,.site-footer{background:rgba(5,6,10,.9);border-color:rgba(53,208,255,.18)}.site-header .brand,.site-header nav a,.site-footer{color:var(--text)}.site-header .brand span,.site-header nav a:hover{color:var(--cyan)}.dossier{max-width:1480px;margin:auto;padding:38px 28px 80px}.dossier-hero,.dossier-panel,.dossier-metric{border:1px solid var(--line);background:linear-gradient(155deg,rgba(16,23,43,.98),rgba(6,9,18,.98));box-shadow:0 18px 50px rgba(0,0,0,.35)}.dossier-hero{border-radius:24px;padding:28px;position:relative;overflow:hidden}.dossier-hero:after{content:"";position:absolute;inset:auto -15% -80%;height:150%;background:radial-gradient(circle,rgba(53,208,255,.15),transparent 63%);pointer-events:none}.dossier-hero>*{position:relative;z-index:1}.eyebrow{margin:0 0 9px;color:var(--green);font-size:.73rem;letter-spacing:.15em;font-weight:900}.dossier-hero h1{margin:0;font-size:clamp(2.3rem,5vw,4.8rem)!important;letter-spacing:-.065em;line-height:.94}.sub{color:var(--muted);font-size:1.05rem;line-height:1.5;max-width:850px}.dossier-nav{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}.dossier-button,.download,.telemetry-load{display:inline-flex;align-items:center;gap:7px;border:1px solid rgba(53,208,255,.32);background:rgba(53,208,255,.08);color:var(--text);border-radius:999px;padding:10px 14px;text-decoration:none;font-weight:800}.dossier-button:hover,.download:hover,.telemetry-load:hover{background:rgba(53,208,255,.17);text-decoration:none}.dossier-metrics{display:grid;grid-template-columns:repeat(4,minmax(150px,1fr));gap:13px;margin:22px 0}.dossier-metric{border-radius:16px;padding:15px}.dossier-metric p{margin:0;color:var(--muted);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;font-weight:800}.dossier-metric strong{display:block;margin-top:8px;font-size:1.5rem}.dossier-metric.q strong{color:var(--pink)}.dossier-layout{display:grid;grid-template-columns:minmax(320px,.88fr) minmax(0,1.4fr);gap:18px}.dossier-panel{border-radius:18px;padding:18px}.dossier-panel h2{margin:0 0 12px;font-size:1.15rem}.dossier-viewer{position:relative;isolation:isolate;contain:layout paint;height:460px;border:1px solid rgba(53,208,255,.2);border-radius:13px;overflow:hidden;background:#05060a}.dossier-viewer>div,.dossier-viewer canvas{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;max-width:100%!important;max-height:100%!important}.note{color:var(--muted);line-height:1.45;font-size:.85rem}.dossier-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:13px}.plot{border:1px solid var(--line);background:#05060a;border-radius:13px;overflow:hidden}.plot img{display:block;width:100%;height:180px;object-fit:contain}.plot b{display:block;padding:10px;overflow-wrap:anywhere;font-size:.82rem}.telemetry-item{margin:10px 0;padding:12px;border:1px solid rgba(53,208,255,.16);border-radius:13px;background:rgba(0,0,0,.15)}.telemetry-top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.telemetry-title{font-weight:800;overflow-wrap:anywhere}.telemetry-load{cursor:pointer;font:inherit;padding:7px 10px}.telemetry-chart{display:none;margin-top:12px;position:relative}.telemetry-chart svg{width:100%;height:280px;display:block;background:#05060a;border-radius:9px}.telemetry-tip{position:absolute;display:none;pointer-events:none;border:1px solid rgba(53,208,255,.45);border-radius:8px;background:rgba(5,6,10,.96);color:var(--text);padding:7px;font-size:.75rem;white-space:nowrap}.downloads{display:flex;flex-wrap:wrap;gap:9px}.download{border-radius:12px;flex-direction:column;align-items:flex-start;min-width:170px}.download small{color:var(--muted);font-weight:500}.wide{margin-top:18px}@media(max-width:850px){.dossier{padding:28px 16px 56px}.dossier-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.dossier-layout{grid-template-columns:1fr}.dossier-viewer{height:340px}}
</style>
{% endblock %}
{% block content %}
<main class="dossier">
  <section class="dossier-hero"><p class="eyebrow">{{ system.campaign|upper }} · {{ 'EXTERNAL LEGACY RUN' if system.external else 'PYMACS RESULT' }}</p><h1>{{ system.system }}</h1><p class="sub">{{ system.project }} · submitted by {{ system.submitter }}{% if system.ligand_name %} · ligand / PROTAC: {{ system.ligand_name }}{% endif %}. This page reads only Kyle-local published assets; it will gain graphs, tables, Q metrics, and final trajectory deliverables as PyMACS analysis finishes.</p><div class="dossier-nav"><a class="dossier-button" href="{{ url_for('results') }}">← All results</a><a class="dossier-button" href="{{ url_for('result_detail', directory=system.directory) }}">↻ Refresh this dossier</a></div></section>
  <section class="dossier-metrics"><article class="dossier-metric"><p>Analysis state</p><strong>{{ 'READY' if system.analysis_ready else 'RUNNING' }}</strong></article><article class="dossier-metric"><p>Published assets</p><strong>{{ system.files|length }}</strong></article><article class="dossier-metric q"><p>Native-contact Q</p><strong>{% if system.qx %}{{ '%.3f'|format(system.qx.mean) }}{% else %}—{% endif %}</strong></article><article class="dossier-metric"><p>Archive</p><strong>{% if system.external %}PENDING{% else %}READY{% endif %}</strong></article></section>
  {% set final_files = system.files|selectattr('relative', 'equalto', 'Final_Trajectory.pdb')|list %}{% set curated_files = system.files|selectattr('relative', 'equalto', 'selected_input_curated.pdb')|list %}
  <section class="dossier-layout"><article class="dossier-panel"><h2>{% if final_files %}Final structure{% else %}Starting structure{% endif %}</h2>{% if final_files %}{% set display_file = final_files[0] %}{% elif curated_files %}{% set display_file = curated_files[0] %}{% else %}{% set display_file = system.files|selectattr('relative', 'equalto', 'selected_input_source.pdb')|list|first %}{% endif %}{% if display_file %}<div class="dossier-viewer" data-pdb="{{ url_for('result_file', relative=system.directory ~ '/' ~ display_file.relative) }}"></div><p class="note">{% if display_file.relative == 'Final_Trajectory.pdb' %}Final trajectory frame rendered from the Kyle-local PDB.{% else %}Starting model with the submitted ligand shown as sticks. The final trajectory structure will replace it when analysis publishes it.{% endif %}</p>{% else %}<p class="note">No PDB structure has been published yet.</p>{% endif %}</article><article class="dossier-panel"><h2>Analysis gallery</h2>{% set dashboards = system.files|selectattr('relative', 'equalto', 'Analysis_Results/PyMACS_Result_Dashboard.html')|list %}{% if dashboards %}<a class="dossier-button" href="{{ url_for('result_file', relative=system.directory ~ '/' ~ dashboards[0].relative, inline='1') }}" target="_blank" rel="noopener">↗ Open interactive PyMACS report</a>{% endif %}{% if system.graphs %}<div class="dossier-grid" style="margin-top:13px">{% for image in system.graphs %}<a class="plot" href="{{ url_for('result_file', relative=system.directory ~ '/' ~ image.relative, inline='1') }}" target="_blank" rel="noopener"><img src="{{ url_for('result_file', relative=system.directory ~ '/' ~ image.relative, inline='1') }}" alt="{{ image.relative }}"><b>{{ image.relative.rsplit('/', 1)[-1] }}</b></a>{% endfor %}</div>{% else %}<p class="note">PyMACS analysis is queued/running. Its plots, figurebook, tables, final structure, and Q readout will appear here automatically after the analysis job writes them.</p>{% endif %}</article></section>
  {% if system.csv_files %}<section class="dossier-panel wide"><h2>Interactive telemetry</h2><p class="note">Load a table to explore it locally in the browser: hover the trace for exact values. The raw CSV remains downloadable below.</p>{% for file in system.csv_files %}<div class="telemetry-item"><div class="telemetry-top"><span class="telemetry-title">{{ file.relative.rsplit('/', 1)[-1] }}</span><button class="telemetry-load" data-csv="{{ url_for('result_file', relative=system.directory ~ '/' ~ file.relative) }}">Load interactive chart</button></div><div class="telemetry-chart"><svg viewBox="0 0 900 280" preserveAspectRatio="none"></svg><span class="telemetry-tip"></span></div></div>{% endfor %}</section>{% endif %}
  <section class="dossier-panel wide"><h2>Deliverables</h2><div class="downloads">{% for file in system.files %}<a class="download" href="{{ url_for('result_file', relative=system.directory ~ '/' ~ file.relative) }}">{{ file.relative.rsplit('/', 1)[-1] }}<small>{{ '%.1f'|format(file.size / 1048576) }} MB</small></a>{% endfor %}</div><p class="note">External source on Triton: {{ system.source_path }}<br>Cheminfo archive: {{ system.archive }}</p></section>
</main>
<script>
document.querySelectorAll('.dossier-viewer[data-pdb]').forEach(async e=>{try{const r=await fetch(e.dataset.pdb),p=await r.text(),v=$3Dmol.createViewer(e,{backgroundColor:'#05060a'});v.addModel(p,'pdb');v.setStyle({},{cartoon:{color:'spectrum'}});v.setStyle({hetflag:true},{stick:{radius:.23,colorscheme:'Jmol'}});v.zoomTo();v.render();addEventListener('resize',()=>v.resize())}catch(_){e.textContent='Structure preview unavailable; download the PDB below.'}});
function csvRows(text){const lines=text.trim().split(/\r?\n/);if(lines.length<2)return[];const h=lines[0].split(',').map(x=>x.trim());return lines.slice(1).map(line=>{const c=line.split(',');const row={};h.forEach((k,i)=>row[k]=(c[i]||'').trim());return row})}
function drawTelemetry(box,rows){const keys=Object.keys(rows[0]||{}),num=k=>rows.map(r=>Number(r[k])).filter(Number.isFinite).length>Math.max(3,rows.length*.6);const yKey=keys.find(k=>num(k)&&/rmsd|rmsf|gyr|radius|q_|sasa|contact|distance/i.test(k))||keys.find(num),xKey=keys.find(k=>num(k)&&/time|frame|step|residue/i.test(k))||keys.find(num);if(!xKey||!yKey){box.textContent='This table has no plottable numeric columns.';return}const pts=rows.map(r=>[Number(r[xKey]),Number(r[yKey])]).filter(p=>p.every(Number.isFinite));if(pts.length<2){box.textContent='Not enough numeric points to draw a trace.';return}const sample=pts.filter((_,i)=>i%Math.ceil(pts.length/1600)===0);const xs=sample.map(p=>p[0]),ys=sample.map(p=>p[1]),minX=Math.min(...xs),maxX=Math.max(...xs),minY=Math.min(...ys),maxY=Math.max(...ys),dx=maxX-minX||1,dy=maxY-minY||1,pad={l:64,r:20,t:22,b:42},W=900,H=280,sx=x=>pad.l+(x-minX)/dx*(W-pad.l-pad.r),sy=y=>H-pad.b-(y-minY)/dy*(H-pad.t-pad.b);const svg=box.querySelector('svg'),tip=box.querySelector('.telemetry-tip');svg.innerHTML=`<line x1="${pad.l}" y1="${H-pad.b}" x2="${W-pad.r}" y2="${H-pad.b}" stroke="#35527c"/><line x1="${pad.l}" y1="${pad.t}" x2="${pad.l}" y2="${H-pad.b}" stroke="#35527c"/><polyline fill="none" stroke="#35d0ff" stroke-width="2.5" points="${sample.map(p=>sx(p[0])+','+sy(p[1])).join(' ')}"/><text x="${pad.l}" y="${H-11}" fill="#83a9cf" font-size="13">${xKey}: ${minX.toPrecision(4)} → ${maxX.toPrecision(4)}</text><text x="${pad.l+4}" y="${pad.t+12}" fill="#83a9cf" font-size="13">${yKey}: ${minY.toPrecision(4)} → ${maxY.toPrecision(4)}</text>`;svg.onmousemove=e=>{const rect=svg.getBoundingClientRect(),fraction=(e.clientX-rect.left)/rect.width,best=sample.reduce((a,p)=>Math.abs((p[0]-minX)/dx-fraction)<Math.abs((a[0]-minX)/dx-fraction)?p:a,sample[0]);tip.textContent=`${xKey}: ${best[0].toPrecision(6)} · ${yKey}: ${best[1].toPrecision(6)}`;tip.style.display='block';tip.style.left=Math.max(4,e.clientX-rect.left+8)+'px';tip.style.top=Math.max(4,e.clientY-rect.top-28)+'px'};svg.onmouseleave=()=>tip.style.display='none'}
document.querySelectorAll('.telemetry-load').forEach(button=>button.onclick=async()=>{const item=button.closest('.telemetry-item'),box=item.querySelector('.telemetry-chart');button.disabled=true;button.textContent='Loading…';try{const response=await fetch(button.dataset.csv);drawTelemetry(box,csvRows(await response.text()));box.style.display='block';button.textContent='Reload chart'}catch(_){box.textContent='Could not load this CSV.';box.style.display='block';button.textContent='Retry'}button.disabled=false});
</script>
{% endblock %}
