#!/usr/bin/env bash
#BSUB -J pymacs_recover_r3_222
#BSUB -L /bin/bash
#BSUB -q normal
#BSUB -P brd
#BSUB -W 04:00
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -oo /projectnb/triton/home/jxs794/Pymacs/backfill_staging/recover_rank3_2z0p_ligand_222.%J.out
#BSUB -eo /projectnb/triton/home/jxs794/Pymacs/backfill_staging/recover_rank3_2z0p_ligand_222.%J.err

# Analysis-only recovery.  The historical backup is read-only; no MD is run.
set -eo pipefail
SOURCE=/projectnb/cheminfo/home/jxs794/MD-Backups/KYLE_MD_JOBS/Angela/Ranked_Docks/Rank3/MD/2Z0P_ligand_222
STAGE=/projectnb/triton/home/jxs794/Pymacs/backfill_staging/recover_rank3_2z0p_ligand_222
test -d "$SOURCE"
test -s "$SOURCE/Final_Trajectory.xtc"
test -s "$SOURCE/Final_Trajectory.pdb"
test -s "$SOURCE/UNK.cgenff.mol2"
rm -rf "$STAGE"
mkdir -p "$STAGE"
cp -a "$SOURCE/Analysis_Results" "$STAGE/"
cp -a "$SOURCE/Final_Trajectory.xtc" "$SOURCE/Final_Trajectory.pdb" \
  "$SOURCE/binding_pocket_only.xtc" "$SOURCE/binding_pocket_only.pdb" \
  "$SOURCE/UNK.cgenff.mol2" "$SOURCE/atomIndex.txt" "$STAGE/"

source /etc/bashrc
set -u
module purge
module load gcc-runtime/13.4.0-none-none-gh6rpjx
module load gromacs/2025.1-gcc-13.4.0-6vq7xfo
source /projectnb/triton/home/jxs794/miniforge3/etc/profile.d/conda.sh
conda activate mdanalysis
export OMP_NUM_THREADS=4
cd "$STAGE"

python /projectnb/triton/home/jxs794/Pymacs/3A_AutomateGromacs.py \
  --ligand UNK --mode ligand --headless --threads 4 \
  --topo Final_Trajectory.pdb --traj Final_Trajectory.xtc
test -s Analysis_Results/InteractionTypes_Framewise.csv
python /projectnb/triton/home/jxs794/Pymacs/3B_NETWORX.py --ligand UNK --filter 0.10 --output UNK --mode ligand
test -s Analysis_Results/NETWORX/UNK_interactive.html
python /projectnb/triton/home/jxs794/Pymacs/5_PyMACS_Result_Dashboard.py --root .
grep -q 'Interactive ligand interaction explorer' Analysis_Results/PyMACS_Result_Dashboard.html
