#!/usr/bin/env bash
#BSUB -J pymacs-1kgy-chain-dynamics
#BSUB -L /bin/bash
#BSUB -q normal
#BSUB -P brd
#BSUB -W 02:00
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -oo /projectnb/triton/home/jxs794/Pymacs/backfill_staging/refresh_1kgy_chain_dynamics.%J.out
#BSUB -eo /projectnb/triton/home/jxs794/Pymacs/backfill_staging/refresh_1kgy_chain_dynamics.%J.err

set -euo pipefail
readonly ROOT=/projectnb/triton/home/jxs794/Molecular_Dynamics/1kgy_ref
readonly STAGE=/projectnb/triton/home/jxs794/Pymacs/backfill_staging/chain_resolved_dynamics_d976611

module purge
module load gcc-runtime/13.4.0-none-none-gh6rpjx
module load gromacs/2025.1-gcc-13.4.0-6vq7xfo
source /projectnb/triton/home/jxs794/miniforge3/etc/profile.d/conda.sh
conda activate mdanalysis
export OMP_NUM_THREADS=4

python "$STAGE/backfill_chain_dynamics.py" --run-dir "$ROOT" --gmx gmx_mpi
python "$STAGE/5_PyMACS_Result_Dashboard.py" --root "$ROOT"
test -s "$ROOT/Analysis_Results/Radius_of_Gyration_1kgy.csv"
test -s "$ROOT/Analysis_Results/Radius_of_Gyration_ref.csv"
test -s "$ROOT/Analysis_Results/PyMACS_Result_Dashboard.html"
