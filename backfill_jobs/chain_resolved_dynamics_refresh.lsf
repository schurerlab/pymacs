#!/usr/bin/env bash
#BSUB -J "pymacs-chain-dynamics[1-2]%2"
#BSUB -L /bin/bash
#BSUB -q normal
#BSUB -P brd
#BSUB -W 12:00
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -oo /projectnb/triton/home/jxs794/Pymacs/backfill_staging/chain_resolved_dynamics.%J.%I.out
#BSUB -eo /projectnb/triton/home/jxs794/Pymacs/backfill_staging/chain_resolved_dynamics.%J.%I.err

# Recover only missing dynamics outputs.  Production trajectories are strictly
# read-only; this job writes CSVs and a refreshed HTML dossier beside each run.
set -euo pipefail
readonly ROOT=/projectnb/triton/home/jxs794/Molecular_Dynamics
readonly STAGE=/projectnb/triton/home/jxs794/Pymacs/backfill_staging/chain_resolved_dynamics_d976611
readonly SYSTEM=$(sed -n "${LSB_JOBINDEX}p" "$STAGE/systems.txt")
readonly RUN="$ROOT/$SYSTEM"

test -n "$SYSTEM"
test -s "$RUN/md_0_1.tpr"
test -s "$RUN/md_0_1.xtc"
test -s "$RUN/atomIndex.txt"

module purge
module load gcc-runtime/13.4.0-none-none-gh6rpjx
module load gromacs/2025.1-gcc-13.4.0-6vq7xfo
source /projectnb/triton/home/jxs794/miniforge3/etc/profile.d/conda.sh
conda activate mdanalysis
export OMP_NUM_THREADS=4

python "$STAGE/backfill_chain_dynamics.py" --run-dir "$RUN" --gmx gmx_mpi
python "$STAGE/5_PyMACS_Result_Dashboard.py" --root "$RUN"
test -s "$RUN/Analysis_Results/PyMACS_Result_Dashboard.html"
echo "[$(date -Is)] Completed $SYSTEM"
