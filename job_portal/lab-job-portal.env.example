# Copy to /etc/lab-job-portal.env on Randy; keep mode 600.
LAB_PORTAL_SECRET=replace-with-a-long-random-secret
LAB_PORTAL_STAGE_ROOT=/var/lib/lab-job-portal/jobs
# A directory writable by jxs794 on each cluster. This service stages projects
# there and the scheduler runs using that account until per-user accounts exist.
LAB_PORTAL_PEGASUS_REMOTE_ROOT=/nethome/jxs794/lab-portal-jobs
# Triton MD campaigns live in the Cheminfo shared lab area so approved lab
# members can inspect, resume, and analyze the same campaign data.
LAB_PORTAL_TRITON_REMOTE_ROOT=/projectnb/cheminfo/share/pymacs-lab/submissions
# Reviewed PyMACS checkout already installed on Triton. It is copied into each
# new run; browser uploads never execute Python.
LAB_PORTAL_PYMACS_ROOT=/projectnb/cheminfo/home/jxs794/Pymacs
LAB_PORTAL_PEGASUS_HOST=pegasus
LAB_PORTAL_TRITON_HOST=triton
LAB_PORTAL_ADMIN_EMAIL=jmschulz@med.miami.edu
# Portal-created campaigns inherit read/write access for this group only.
LAB_PORTAL_COLLABORATION_GROUP=cheminfo
# Reviewed script used only by the new-account "Set up cluster access" flow.
# It prompts for the member's university password through the browser once to
# install their dedicated key on Triton and Pegasus.
LAB_PORTAL_SSH_SETUP_SCRIPT=/home/jxs794/lab-job-portal/setup-cluster-ssh.sh
# Set to 1 when the browser reaches the portal over HTTPS (such as Tailscale
# Serve), so authentication cookies never travel over plain HTTP.
LAB_PORTAL_COOKIE_SECURE=1
PORT=8788
## Bind to 0.0.0.0 only when the portal is intentionally available to the
## trusted UM/VPN network. Keep 127.0.0.1 for a Funnel-only deployment.
PORTAL_BIND_HOST=127.0.0.1
PORT=8788
